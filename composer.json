{
    "name": "avaliacao/main",
    "description": "Sistema de avaliação com Slim Framework e PHP-ActiveRecord",
    "require": {
        "php": "^8.2",
        "slim/slim": "^2.6",
        "php-activerecord/php-activerecord": "dev-master",
        "twig/twig": "^3.27",
        "doctrine/migrations": "^3.8",
        "cweagans/composer-patches": "^1.7"
    },
    "config": {
        "platform": {
            "php": "8.2.0"
        },
        "allow-plugins": {
            "cweagans/composer-patches": true
        }
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Gilglécio Santos",
            "email": "gilglecio_765@hotmail.com"
        }
    ],
    "extra": {
        "patches": {
            "php-activerecord/php-activerecord": {
                "Compatibilidade com PHP 8": "patches/php-activerecord-php8.patch"
            }
        }
    }
}
